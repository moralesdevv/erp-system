# Compose uses this file for PostgreSQL, Redis and the deployment domain.
# Keep real values in .env only. Never commit .env.

# PostgreSQL
POSTGRES_DB=erp_dev
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Domain used by production deployment scripts
DOMAIN=localhost
