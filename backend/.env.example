# ============================================================
# ERP BACKEND - ENVIRONMENT VARIABLES
# Copy to .env (dev) or .env.production (prod)
# NEVER commit real .env files
# ============================================================

NODE_ENV=development
PORT=3000

# ─── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://erp_user:CHANGE_ME@postgres:5432/erp_dev?schema=public"

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# ─── JWT Secrets (generate with: openssl rand -base64 64) ──
JWT_ACCESS_SECRET=CHANGE_THIS_ACCESS_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── Cookie ────────────────────────────────────────────────
COOKIE_SECRET=CHANGE_THIS_COOKIE_SECRET_MIN_32_CHARS

# ─── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3001,https://yourdomain.com

# ─── File Upload ───────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ─── Rate Limiting ─────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=./logs

# ─── Argon2 ────────────────────────────────────────────────
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
